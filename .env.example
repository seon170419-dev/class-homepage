# 로컬 개발용. Vercel에 설치할 때는 이 파일이 필요 없어요 (Neon·Blob 연결 시 자동 설정).

# Postgres 연결 문자열
# DATABASE_URL: 앱이 사용 (풀러 주소여도 됨)
# DIRECT_URL: 마이그레이션 전용 직접 연결 (없으면 DATABASE_URL_UNPOOLED → DATABASE_URL 순으로 사용)
DATABASE_URL=""
DIRECT_URL=""

# 선택: 로그인 쿠키 서명 키. 비워 두면 DATABASE_URL에서 자동으로 만들어 써요.
SESSION_SECRET=""

# 선택: 설치 화면(/setup)에서 요구할 설치 코드
SETUP_CODE=""

# 선택: Vercel Blob 토큰. 비워 두면 업로드 파일을 public/uploads 에 저장해요.
BLOB_READ_WRITE_TOKEN=""

# 선택: AI 기능(생기부 초안, 칭찬 태그 추천, 부적절 내용 검토). 비워 두면 해당 버튼이 꺼져요.
OPENAI_API_KEY=""

# 개발용 샘플 데이터(npm run db:seed)에서만 사용
TEACHER_USERNAME="teacher"
TEACHER_PASSWORD=""
